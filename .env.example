# Deployment/seeding configuration — copy to .env and fill in.
# .env is gitignored; NEVER commit real keys.

# Funded deployer EOA for Base Sepolia (gas). Generate a fresh burner:
#   cast wallet new
PRIVATE_KEY=

# Public endpoints (defaults shown).
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# Filled in after the Aqua infra deployment (contracts/lib submodules,
# see docs/DEPLOYMENT.md). Required by DeploySlope.s.sol / SeedStrategy.s.sol.
AQUA_REGISTRY=
AQUA_ROUTER=

# Privy (embedded wallets + delegated signing). From the Privy dashboard.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
VITE_PRIVY_APP_ID=

# The Graph Subgraph Studio. Create the subgraph and keys at
# https://thegraph.com/studio/ — deploy key authenticates `graph deploy`
# (subgraph/package.json), API key authenticates queries against the
# versioned endpoint. Both live ONLY in .env.
GRAPH_DEPLOY_KEY=
GRAPH_API_KEY=
